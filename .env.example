# Copy this file to .env and fill in real values. .env is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Used when running npm run dev locally (databases running in Docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_review_platform

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Provider (pick one) ────────────────────────────────────────────────────

# Option A: Google Gemini — free tier via https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=

# Option B: OpenRouter — use openrouter/free for zero-cost models
# See https://openrouter.ai/models for model strings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free