# Copy this file to .env and fill in real values. .env is gitignored;
# this file is the documented contract of what's required.

# Used when running `npm run dev` directly on your machine, with
# Postgres/Redis running in Docker (their ports are published to localhost).
# If you instead run everything via `docker compose up`, the web service
# uses the postgres/redis hostnames baked into docker-compose.yml — these
# values are not used in that case.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/code_review_platform
REDIS_URL=redis://localhost:6379

# Get a key at https://openrouter.ai — required for any AIService calls.
OPENROUTER_API_KEY=